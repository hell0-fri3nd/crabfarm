// Crabfarm API — database schema
// Paste into https://dbdiagram.io
// Source of truth: SQLModel models in api/app/**/models.py (see api/context/04-schema.md)
// Keep this file updated in the same commit as any model/migration change.

Project crabfarm {
  database_type: 'PostgreSQL'
  Note: 'One PostgreSQL database, one schema per module: auth, audit, crab_management, devices. No foreign keys between modules; cross-module ids are plain indexed columns.'
}

//// ───────────── auth ─────────────

Enum auth.user_role {
  DEVELOPER
  ADMIN
  STAFF
}

Table auth.users {
  id         uuid         [pk, note: 'uuid4 from app']
  name       varchar(150) [not null]
  email      varchar(254) [not null, unique]
  password   varchar(255) [not null, note: 'argon2 hash']
  pin        varchar(255) [not null, note: 'argon2 hash of the 4-digit pin']
  role       auth.user_role [not null, default: 'STAFF']
  is_active  boolean      [not null, default: true, note: 'false = deactivated']
  has_default_credentials boolean [not null, default: false, note: 'true on create/reset until both password and pin are changed (API: needs_onboarding)']
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`, note: 'onupdate now()']

  indexes {
    id    [name: 'ix_auth_users_id']
    email [unique, name: 'ix_auth_users_email']
  }
}

//// ───────────── audit ─────────────

Table audit.audit_events {
  id            uuid        [pk, default: `gen_random_uuid()`]
  occurred_at   timestamptz [not null, default: `now()`]
  recorded_at   timestamptz [not null, default: `now()`]
  occurred_date date        [note: "GENERATED: (occurred_at AT TIME ZONE 'Asia/Manila')::date"]
  occurred_time time(0)     [note: "GENERATED: (occurred_at AT TIME ZONE 'Asia/Manila')::time(0)"]

  actor_id      uuid         [null, note: 'auth.users.id — no FK (audit outlives users)']
  actor_type    varchar(16)  [not null]
  actor_role    varchar(32)  [null, note: 'snapshot at event time']
  actor_email   varchar(320) [null, note: 'snapshot at event time']
  session_hash  char(64)     [null]

  source_ip     inet         [null]
  user_agent    text         [null]
  geo_country   varchar(64)  [null]
  geo_city      varchar(128) [null]
  page_path     text         [null]

  service       varchar(32)  [not null]
  source        varchar(16)  [null]
  version       varchar(32)  [null]
  environment   varchar(16)  [null]
  http_method   varchar(8)   [null]
  http_path     text         [null]
  request_id    uuid         [null]

  action        varchar(48)  [not null]
  target_type   varchar(48)  [null]
  target_id     uuid         [null]
  target_label  text         [null]

  outcome       varchar(16)  [not null]
  severity      varchar(16)  [not null]
  http_status   int          [null]
  reason        text         [null]
  changes       jsonb        [null]

  indexes {
    occurred_at [name: 'ix_audit_audit_events_occurred_at']
    actor_id    [name: 'ix_audit_audit_events_actor_id']
    action      [name: 'ix_audit_audit_events_action']
  }

  Note: 'Append-only. Intentionally denormalized (actor snapshots, generated local date/time).'
}

//// ───────────── crab_management ─────────────

Enum crab_management.log_type {
  prediction
  actual
}

Table crab_management.crabs {
  id       serial      [pk]
  name     varchar(50) [not null, unique, note: 'e.g. A1..E5']
  group_by varchar(10) [not null, note: 'group letter A..E']
}

Table crab_management.batches {
  id         serial      [pk]
  user_id    uuid        [not null, note: 'auth.users.id — no FK (cross-module)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'ix_crab_management_batches_user_id']
  }
}

Table crab_management.logs {
  id         serial         [pk]
  batch_id   int            [null]
  crab_id    int            [not null]
  user_id    uuid           [not null, note: 'auth.users.id — no FK (cross-module)']
  log_type   crab_management.log_type [not null]
  width_mm   numeric(10,2)  [null, note: 'carapace width']
  weight_g   numeric(10,2)  [null]
  created_at timestamptz    [not null, default: `now()`]

  indexes {
    batch_id [name: 'ix_crab_management_logs_batch_id']
    crab_id  [name: 'ix_crab_management_logs_crab_id']
    user_id  [name: 'ix_crab_management_logs_user_id']
    log_type [name: 'ix_crab_management_logs_log_type']
  }
}

//// ───────────── devices ─────────────

Enum devices.water_sensor_name {
  temperature
  ph
  salinity
  ammonia
  turbidity
  oxygen
}

Enum devices.water_sensor_status {
  normal
  warning
  danger
}

Table devices.water_sensor_logs {
  id          bigint        [pk, increment]
  sensor      devices.water_sensor_name   [not null]
  value       numeric(10,3) [not null]
  status      devices.water_sensor_status [not null, note: 'snapshot: the status when logged']
  measured_at timestamptz   [not null]
  slot_at     timestamptz   [not null, note: 'start of the 30-minute logging slot']
  created_at  timestamptz   [not null, default: `now()`]

  indexes {
    (sensor, slot_at) [unique, name: 'uq_water_sensor_logs_sensor']
    sensor      [name: 'ix_devices_water_sensor_logs_sensor']
    status      [name: 'ix_devices_water_sensor_logs_status']
    measured_at [name: 'ix_devices_water_sensor_logs_measured_at']
  }
}

Enum devices.schedule_days {
  "every-day"
  weekdays
  weekends
  "mon-wed-fri-sun"
}

Table devices.cages {
  id         uuid        [pk, note: 'uuid4 from app']
  group_code varchar(10) [not null, note: 'A..E, same letters as crab groups']
  cage_name  varchar(50) [not null, unique, note: 'same value as the crab name, e.g. A1']
  is_active  boolean     [not null, default: true, note: 'false = schedules skip this cage']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'onupdate now()']

  indexes {
    group_code [name: 'ix_devices_cages_group_code']
  }

  Note: 'Seeded with one active cage per crab name (A1..E5). CHECK ck_cages_name_in_group: left(cage_name, 1) = group_code.'
}

Table devices.schedules {
  id         uuid        [pk, note: 'uuid4 from app']
  name       varchar(40) [not null]
  feed_time  time        [not null, note: 'farm clock (farm_time_zone)']
  days       devices.schedule_days [not null, default: 'every-day']
  is_enabled boolean     [not null, default: true]
  user_id    uuid        [not null, note: 'auth.users.id — no FK (cross-module)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'onupdate now()']
  deleted_at timestamptz [null, note: 'soft delete']

  indexes {
    is_enabled [name: 'ix_devices_schedules_is_enabled']
    user_id    [name: 'ix_devices_schedules_user_id']
  }
}

Table devices.schedule_groups {
  schedule_id uuid        [not null]
  group_code  varchar(10) [not null, note: 'matches cages.group_code; the service checks that cages exist in this group']

  indexes {
    (schedule_id, group_code) [pk, name: 'pk_schedule_groups']
    group_code [name: 'ix_devices_schedule_groups_group_code']
  }

  Note: 'The groups a schedule feeds. The service requires at least one, so a schedule with no rows feeds nothing.'
}

//// ───────────── relationships (within a module only) ─────────────

Ref fk_logs_batch_id_batches: crab_management.logs.batch_id > crab_management.batches.id
Ref fk_logs_crab_id_crabs:    crab_management.logs.crab_id > crab_management.crabs.id
Ref fk_schedule_groups_schedule_id_schedules: devices.schedule_groups.schedule_id > devices.schedules.id [delete: cascade]