// Crabfarm API — database schema
// Paste into https://dbdiagram.io
// Source of truth: SQLModel models in api/app/**/models.py (see api/context/04-schema.md)
// Keep this file updated in the same commit as any model/migration change.

Project crabfarm {
  database_type: 'PostgreSQL'
  Note: 'One PostgreSQL database, one schema per module: auth, audit, crab_management. No foreign keys between modules; cross-module ids are plain indexed columns.'
}

//// ───────────── auth ─────────────

Enum auth.user_role {
  ADMIN
  USER
  STAFF
}

Table auth.users {
  id         uuid         [pk, note: 'uuid4 from app']
  name       varchar(150) [not null]
  email      varchar(254) [not null, unique]
  password   varchar(255) [not null, note: 'argon2 hash']
  pin        varchar(4)   [null, note: 'hashed 4-digit pin']
  role       auth.user_role [not null, default: 'USER']
  created_at timestamptz  [not null, default: `now()`]
  updated_at timestamptz  [not null, default: `now()`, note: 'onupdate now()']

  indexes {
    id    [name: 'ix_auth_users_id']
    email [unique, name: 'ix_auth_users_email']
  }
}

//// ───────────── audit ─────────────

Table audit.audit_events {
  id            uuid        [pk, default: `gen_random_uuid()`]
  occurred_at   timestamptz [not null, default: `now()`]
  recorded_at   timestamptz [not null, default: `now()`]
  occurred_date date        [note: "GENERATED: (occurred_at AT TIME ZONE 'Asia/Manila')::date"]
  occurred_time time(0)     [note: "GENERATED: (occurred_at AT TIME ZONE 'Asia/Manila')::time(0)"]

  actor_id      uuid         [null, note: 'auth.users.id — no FK (audit outlives users)']
  actor_type    varchar(16)  [not null]
  actor_role    varchar(32)  [null, note: 'snapshot at event time']
  actor_email   varchar(320) [null, note: 'snapshot at event time']
  session_hash  char(64)     [null]

  source_ip     inet         [null]
  user_agent    text         [null]
  geo_country   varchar(64)  [null]
  geo_city      varchar(128) [null]
  page_path     text         [null]

  service       varchar(32)  [not null]
  source        varchar(16)  [null]
  version       varchar(32)  [null]
  environment   varchar(16)  [null]
  http_method   varchar(8)   [null]
  http_path     text         [null]
  request_id    uuid         [null]

  action        varchar(48)  [not null]
  target_type   varchar(48)  [null]
  target_id     uuid         [null]
  target_label  text         [null]

  outcome       varchar(16)  [not null]
  severity      varchar(16)  [not null]
  http_status   int          [null]
  reason        text         [null]
  changes       jsonb        [null]

  indexes {
    occurred_at [name: 'ix_audit_audit_events_occurred_at']
    actor_id    [name: 'ix_audit_audit_events_actor_id']
    action      [name: 'ix_audit_audit_events_action']
  }

  Note: 'Append-only. Intentionally denormalized (actor snapshots, generated local date/time).'
}

//// ───────────── crab_management ─────────────

Enum crab_management.logs_enum {
  prediction
  actual
}

Table crab_management.crabs {
  id       serial      [pk]
  name     varchar(50) [not null, unique, note: 'e.g. A1..E5']
  group_by varchar(10) [not null, note: 'group letter A..E']
}

Table crab_management.batches {
  id         serial      [pk]
  user_id    uuid        [not null, note: 'auth.users.id — no FK (cross-module)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'ix_crab_management_batches_user_id']
  }
}

Table crab_management.logs {
  id         serial         [pk]
  batch_id   int            [null]
  crab_id    int            [not null]
  user_id    uuid           [not null, note: 'auth.users.id — no FK (cross-module)']
  type       crab_management.logs_enum [not null]
  width      numeric(10,2)  [null, note: 'carapace width']
  weight     numeric(10,2)  [null]
  created_at timestamptz    [not null, default: `now()`]

  indexes {
    batch_id [name: 'ix_crab_management_logs_batch_id']
    crab_id  [name: 'ix_crab_management_logs_crab_id']
    user_id  [name: 'ix_crab_management_logs_user_id']
    type     [name: 'ix_crab_management_logs_type']
  }
}

//// ───────────── relationships (within a module only) ─────────────

Ref fk_logs_batch_id_batches: crab_management.logs.batch_id > crab_management.batches.id
Ref fk_logs_crab_id_crabs:    crab_management.logs.crab_id > crab_management.crabs.id
