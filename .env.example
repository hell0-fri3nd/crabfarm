# API Settings
PROJECT_NAME=crab_farm
API_PREFIX=/api/v1
SECRET_KEY=<YOUR_SECRET_KEY>
DATABASE_URI=postgresql://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@localhost:4627/<YOUR_DB_NAME>


# Docker (nginx is the only public entry point)
WEB_PORT=443
WEB_ORIGIN=https://localhost    # the address people open, with the port unless it is 443; the HTTPS certificate and live detection both use it


# Cookie Settings
COOKIE_SECURE=false           # default: true in production, false otherwise
COOKIE_PATH=/                  # default: /
ACCESS_COOKIE_SAMESITE=lax     # lax | strict | none, default: lax
REFRESH_COOKIE_SAMESITE=strict # lax | strict | none, default: strict


# JWT Settings
JWT_SECRET_KEY=<YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARS>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1
JWT_REFRESH_TOKEN_REMEMBER_ME_DAYS=7


# Database Settings
DB_USER=<YOUR_DB>
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=<YOUR_DB_NAME>


# Rabbit MQ Settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=<YOUR_RABBITMQ_USER>
RABBITMQ_PASSWORD=<YOUR_RABBITMQ_PASSWORD>

# Water sensor thresholds: inclusive [low, high] bands, null = no limit. Anything outside both lists is Normal.
# Used by the API and the worker, and shown by the web. Restart the worker after changing them.
WATER_THRESHOLD_TEMPERATURE='{"warning":[[24.1,24.5],[35.1,35.5]],"danger":[[null,24.1],[35.5,null]]}'
WATER_THRESHOLD_PH='{"warning":[[7.1,7.4],[9.1,9.5]],"danger":[[null,7.1],[9.5,null]]}'
WATER_THRESHOLD_SALINITY='{"warning":[[14.5,14.9],[20.1,20.5]],"danger":[[null,14.5],[20.5,null]]}'
WATER_THRESHOLD_AMMONIA='{"warning":[[1.0,3.0]],"danger":[[3.0,null]]}'
WATER_THRESHOLD_TURBIDITY='{"warning":[[10,20],[40,50]],"danger":[[null,10],[50,null]]}'
WATER_THRESHOLD_OXYGEN='{"warning":[[4.5,4.9],[12.1,12.5]],"danger":[[0,4.5],[12.5,null]]}'

# Live detection (api/app/core/config.py)
YOLO_WEIGHTS=yolo11s.pt
YOLO_CONFIDENCE=0.3
DETECTION_TICKET_RATE_LIMIT=30
DETECTION_ALLOWED_ORIGINS=["http://localhost:3000"]
DETECTION_STICKER_MM=30
DETECTION_CAMERA_DISTANCE_MM=304.8
DETECTION_WIDTH_OFFSET_MM=-5
